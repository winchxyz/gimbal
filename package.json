{
  "name": "gimbal",
  "private": true,
  "type": "module",
  "license": "BUSL-1.1",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "engine",
    "web",
    "tools"
  ],
  "scripts": {
    "ci": "node scripts/ci.mjs",
    "build":"npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "attack": "npm run attack -w engine --",
    "report": "npm run report -w engine --",
    "backtest:checks": "npm run backtest:checks -w engine --"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "7.0.2"
  }
}

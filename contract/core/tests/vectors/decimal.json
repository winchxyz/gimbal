{
  "file": "decimal.json",
  "brief": "C1 (decimal.rs); used by every brief that takes a decimal string (C3 px/sz, C5 Orderly price/quantity, C6/C8 amounts)",
  "generator": "gen/decimal.mjs (regex + BigInt), cross-checked by gen/decimal_check.py (char-by-char parser)",
  "rule": "canonical = \"0\" | [1-9][0-9]* , optionally \".\" + 1..8 ASCII digits not ending in \"0\"; value in 1e-8 units must fit u128; anything else is E_DECIMAL",
  "fields": {
    "input": "the exact string passed to the parser (JSON-escaped; \\u0661 is one non-ASCII character)",
    "ok": "true = accept",
    "units_e8": "accepted value in 1e-8 units, as a decimal string (may exceed u64)",
    "fits_u64": "whether units_e8 fits a u64 (callers that store u64 must refuse the rest)",
    "code": "refusal code when ok is false",
    "reason": "hint only; tests should not depend on it"
  },
  "cases": [
    {
      "input": "0",
      "ok": true,
      "units_e8": "0",
      "fits_u64": true,
      "note": "zero is canonical (a zero size is E_SIZE, not E_DECIMAL)"
    },
    {
      "input": "1",
      "ok": true,
      "units_e8": "100000000",
      "fits_u64": true,
      "note": "integer"
    },
    {
      "input": "10",
      "ok": true,
      "units_e8": "1000000000",
      "fits_u64": true,
      "note": "trailing zeros in the integer part are fine"
    },

{
  "$description": "Gimbal · Stage design tokens. Mirrors tokens.css.",
  "color": {
    "bg": "#0A0A0A",
    "sel": "#141414",
    "line": "#1E1E1D",
    "line-2": "#2E2E2C",
    "ink": "#F2F2F0",
    "ink-2": "#7E7E7B",
    "ink-3": "#4A4A48",
    "level": "#00EC97",
    "pos": "#3FD9A0",
    "watch": "#F0A531",
    "danger": "#FF5A5F",
    "testnet": "#6FD8E8",
    "replay": "#B9A6FF"
  },
  "font": {
    "text": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Gimbal Sans', sans-serif",
    "display": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Gimbal Sans', sans-serif",
    "mono": "ui-monospace, 'SF Mono', 'Gimbal Mono', monospace",
    "fallbackFiles": {
      "Gimbal Sans": [
        "fonts/Inter.subset.woff"
      ],
      "Gimbal Mono": [
        "fonts/GeistMono.subset.woff"
      ]
    },
    "rule": "SF on Apple devices; the open fallbacks everywhere else; never Arial, Segoe or Helvetica",
    "fallbackFamilies": {
      "Gimbal Sans": "Inter 4.1, variable wght 400–600 and opsz 14–32, SIL OFL 1.1",
      "Gimbal Mono": "Geist Mono, SIL OFL 1.1"
    }
  },
  "type": {
    "hero": {
      "size": 112,
      "lineHeight": 0.9,
      "weight": 400,
      "tracking": "-0.03em",
      "font": "display",
      "use": "desk value"
    },
    "display": {
      "size": 72,
      "lineHeight": 1,
      "weight": 400,
      "tracking": "-0.025em",
      "font": "display",
      "use": "selected window asset and net APR"
    },
    "xl": {
      "size": 48,
      "lineHeight": 1,
      "weight": 400,
      "tracking": "-0.025em",
      "font": "display",
      "use": "venue names"
    },
    "num": {
      "size": 44,
      "lineHeight": 1,
      "weight": 400,
      "tracking": "-0.02em",
      "font": "display",
      "use": "distance to liquidation"
    },
    "l": {
      "size": 20,
      "lineHeight": 1.2,
      "weight": 400,
      "tracking": "0",
      "font": "display",
      "use": "list assets and values"
    },
    "m": {
      "size": 15,
      "lineHeight": 1.45,
      "weight": 400,
      "tracking": "0",
      "font": "text",
      "use": "body"
    },
    "s": {
      "size": 13,
      "lineHeight": 1.4,
      "weight": 400,
      "tracking": "0",
      "font": "text",
      "use": "labels and captions"
    },
    "btn": {
      "size": 14,
      "lineHeight": 1,
      "weight": 500,
      "tracking": "0",
      "font": "text",
      "use": "buttons"
    }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48,
    "8": 64,
    "9": 80
  },
  "layout": {
    "gutter": 64,
    "gutterPhone": 16,
    "header": 72,
    "status": 52,
    "listWidth": 600
  },
  "radius": {
    "none": 0,
    "button": 18,
    "dot": "50%"
  },
  "motion": {
    "ease": "cubic-bezier(.25, .1, .25, 1)",
    "fast": 120,
    "base": 240,
    "tilt": 400,
    "reducedMotion": "all durations become 0"
  }
}
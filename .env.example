# Copy to .env and fill in. Never commit .env.
GIMBAL_MODE=replay                 # replay | testnet | mainnet

# NEAR
NEAR_NETWORK=testnet               # testnet | mainnet
NEAR_RPC_URL=
GIMBAL_CONTRACT_ID=
OWNER_ACCOUNT_ID=
OPERATOR_PRIVATE_KEY=              # FunctionCall key on the owner's account (operator methods only)
OPERATOR_ALLOWANCE_NEAR=5          # allowance of that key, set at onboarding; the engine checks what is left before every signature
DESK_ID=

# Venues
HL_API_URL=                        # https://api.hyperliquid-testnet.xyz or https://api.hyperliquid.xyz
SOLANA_RPC_URL=
PHOENIX_API_URL=https://perp-api.phoenix.trade
ORDERLY_API_URL=                    # https://testnet-api.orderly.org or https://api.orderly.org
ORDERLY_BROKER_ID=
ARBITRUM_RPC_URL=                  # Orderly money out: EIP-3009 transfers on Arbitrum
RELAYER_EVM_PRIVATE_KEY=           # gas-only Arbitrum wallet (a few dollars of ETH); never holds desk money

# Referral and invite codes (names only; mainnet values; the deploy passes them into `new`)
HL_REFERRAL_CODE=                  # empty on testnet unless the code exists on Hyperliquid testnet
ORDERLY_REFERRAL_CODE=             # must belong to ORDERLY_BROKER_ID; empty if Gimbal runs its own broker
PHOENIX_INVITE_CODE=               # Phoenix invite gate before trader registration

# NEAR Intents 1Click (optional; without it every transfer pays +0.2 % (20 bps))
ONECLICK_API_KEY=

# NEAR AI (optional: policy drafts, veto checks, journal lines; without it drafting is off and windows pass unchecked)
NEAR_AI_API_KEY=

# Engine
ENGINE_PORT=8790

# Copy to .env and fill in. Never commit .env.
GIMBAL_MODE=replay                 # replay | testnet | mainnet

# NEAR
NEAR_NETWORK=testnet               # testnet | mainnet
NEAR_RPC_URL=
GIMBAL_CONTRACT_ID=
OWNER_ACCOUNT_ID=
OPERATOR_ACCOUNT_ID=               # only with a separate operator account (set_operator); empty = the key sits on OWNER_ACCOUNT_ID
OPERATOR_PRIVATE_KEY=              # FunctionCall key on the owner's account (operator methods only)
OPERATOR_ALLOWANCE_NEAR=5          # allowance of that key, set at onboarding; the engine checks what is left before every signature
DESK_ID=

# Venues
HL_API_URL=                        # https://api.hyperliquid-testnet.xyz or https://api.hyperliquid.xyz
SOLANA_RPC_URL=
PHOENIX_API_URL=https://perp-api.phoenix.trade
ORDERLY_API_URL=                    # https://testnet-api.orderly.org or https://api.orderly.org
ORDERLY_BROKER_ID=
ARBITRUM_RPC_URL=                  # Orderly money out: EIP-3009 transfers on Arbitrum
RELAYER_EVM_PRIVATE_KEY=           # gas-only Arbitrum wallet (a few dollars of ETH); never holds desk money

# Referral codes (names only; mainnet values; the deploy passes them into `new`)
HL_REFERRAL_CODE=                  # empty on testnet unless the code exists on Hyperliquid testnet
ORDERLY_REFERRAL_CODE=             # must belong to ORDERLY_BROKER_ID; empty if Gimbal runs its own broker
PHOENIX_REFERRAL_CODE=             # bound once per desk after registration (referral/activate-tx)

# NEAR Intents 1Click (optional; without it every transfer pays +0.2 % (20 bps))
ONECLICK_API_KEY=

# NEAR AI (optional: policy drafts, veto checks, journal lines; without it drafting is off and windows pass unchecked)
NEAR_AI_API_KEY=

# Engine
ENGINE_PORT=8790
GIMBAL_HOST=127.0.0.1              # address the engine listens on; keep it local (it refuses non-local Host and Origin headers)
GIMBAL_REPLAY_FILE=                # replay mode: a recording made with serve --record; empty = newest engine/fixtures/replay/scan-*.jsonl.gz
GIMBAL_REPLAY_SPEED=1              # replay mode: how many times faster than real time the recording plays
GIMBAL_POLICY_FILE=                # the desk's ContractPolicy as JSON (get_desk's policy), checked at start; empty = no desk (E_NO_DESK)
GIMBAL_STATE_DIR=                  # where the confirmed engine rules (PUT /strategy) and serve's pair trader state are kept across restarts; empty = engine/state/ (gitignored) for the rules, the per-user state directory for the trader
GIMBAL_SETUP=                      # 1 turns on POST /setup: venue setup signs through OPERATOR_PRIVATE_KEY; empty = off
GIMBAL_PUBLIC_IP=                  # setup: the engine's public IPs (commas or spaces) a desk's Orderly IP list must hold before setup applies it; empty = looked up from an echo service
GIMBAL_TRADE=                      # mainnet serve: 1 lets the pair trade (reduce-only: panic_close, a rescue's reduce, the ADL unwind) through OPERATOR_PRIVATE_KEY, from the main checkout only, never with --once; empty = alert only
GIMBAL_TRADER_FRESH=               # leave empty; for one start only, <contract>/<desk> (e.g. the canary contract id/canary) adopts the venues' legs as the pair with a new ADL budget when the trader state file is missing or unusable; ignored over a usable file (move it aside first) and for any other value; a missing trader state file is not a fresh start without it
GIMBAL_ORDERLY_PAIRS=              # serve, default off: 1 opens the desk's private Orderly session (one orderly_ws_auth through OPERATOR_PRIVATE_KEY per session) so risk and the loop read the Orderly account; empty = off, nothing opened or signed
GIMBAL_LOG_EGRESS=                 # serve: 1 logs the public IPv4 addresses its traffic leaves from (three GETs to api.ipify.org, at start and hourly) as `egress ipv4: a, b, c`; empty = no request, no line
GIMBAL_PAIR_SYMBOL=              # serve: the pair's base when both legs are flat, as the policy spells it (XLM, kPEPE); empty = the open pair, else the saved one
GIMBAL_VIEW_TOKEN=                 # read-only view (docs/deploy-railway.md): its bearer token, from openssl rand -hex 32 (patterns are refused); empty = the view is off
GIMBAL_VIEW_PORT=                  # read-only view: the port it listens on, on 0.0.0.0; empty = PORT (Railway sets it); never ENGINE_PORT
GIMBAL_VIEW_ORIGINS=               # read-only view: dashboard origins allowed by CORS, commas or spaces (https://host[:port], no path); empty = no browser page

# Web (Vite reads VITE_* from web/.env, not from this file)
VITE_RELAYER_IP=                   # the engine's public IPs (commas or spaces) the onboarding page checks an Orderly IP list against; empty = the page lets the owner sign no IP list
